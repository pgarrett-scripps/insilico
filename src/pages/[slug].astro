---
/**
 * The hand-written editorial pages, which are the ones named in
 * src/lib/pages.js and no others.
 *
 * These are prose, so they get the reading column and nothing else. There is no
 * instrument chrome, no data panels. The title and lede come from the
 * allowlist, so the page opens with a proper title block rather than dropping
 * the reader straight into body text.
 */
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { EDITORIAL_SLUGS, editorialPage } from "../lib/pages.js";

/**
 * Only the pages named in src/lib/pages.js are built. The collection is
 * already restricted to those files, so this route refuses anything else
 * rather than falling back to a bare slug and an untitled page. A build that
 * would publish a working note from `docs/` fails here instead.
 */
export async function getStaticPaths() {
  const pages = await getCollection("pages");
  const found = pages.map((entry) => entry.id).sort();

  const unlisted = found.filter((id) => !EDITORIAL_SLUGS.includes(id));
  if (unlisted.length) {
    throw new Error(
      `docs/ holds Markdown that is not an editorial page: ${unlisted.join(", ")}. `
        + "Add it to EDITORIAL_PAGES in src/lib/pages.js to publish it, or leave it unlisted.",
    );
  }

  const missing = EDITORIAL_SLUGS.filter((slug) => !found.includes(slug));
  if (missing.length) {
    throw new Error(
      `EDITORIAL_PAGES names pages with no file in docs/: ${missing.join(", ")}.`,
    );
  }

  return pages.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const page = editorialPage(entry.id);
const title = page.title;
const lede = page.lede;
---

<Base title={title} description={lede || ""}>
  <div class="shell shell--column doc">
    <header class="doc__head">
      <p class="label doc__eyebrow">In Silico</p>
      <h1 class="doc__title">{title}</h1>
      {lede && <p class="doc__lede">{lede}</p>}
    </header>

    <div class="prose">
      <Content />
    </div>
  </div>
</Base>

<style>
  .doc {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .doc__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--rule);
  }

  .doc__eyebrow {
    color: var(--accent);
  }

  .doc__title {
    font-size: clamp(2.1rem, 5.5vw, 3.2rem);
  }

  .doc__lede {
    max-width: 58ch;
    font-size: var(--t-1);
    line-height: 1.5;
    color: var(--ink-dim);
  }

  /* The Markdown pipeline demotes the document's opening h1 to h2. The page
     title above already names the document, so hide that repeated heading. */
  .prose :global(h2:first-child) {
    display: none;
  }

  .prose :global(h3:first-child),
  .prose :global(h4:first-child),
  .prose :global(h2:first-child + h3) {
    margin-top: 0;
  }
</style>
