---
import Base from "../layouts/Base.astro";
import { corpus, STATUS, statistics } from "../lib/corpus.js"

const stats = statistics();
const papers = corpus().slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const STAGES = [
  { stage: "Desk", who: "Integrity scan · editorial triage", out: "Pass, or a desk rejection" },
  { stage: "Review", who: "Scientific validity · Quantitative evidence · Contribution and prior work · Reporting and reproducibility · Ethics", out: "5 scored reports" },
  { stage: "Audit", who: "Citation integrity · Methods completeness", out: "2 factual checklists" },
  { stage: "Debate", who: "Advocate vs. Skeptic, parallel rounds", out: "Full transcript" },
  { stage: "Synthesis", who: "Debate synthesizer", out: "The debate, condensed for the editor" },
  { stage: "Decision", who: "Editor-in-chief, reading every report directly", out: "Recommendation + letter" },
];
---

<Base>
  <div class="hero">
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="shell hero__inner">
      <p class="label hero__eyebrow">An open, AI-refereed overlay journal</p>
      <h1 class="hero__title">In&nbsp;Silico</h1>
      <p class="hero__lede">
        We don't host papers. Point us at a preprint and a panel of thirteen
        agents reviews it. We publish <em>the entire review</em> next to a link
        to your work.
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href={`${base}/reviews/`}>Browse reviews</a>
        <a class="btn" href={`${base}/submit/`}>Submit a preprint</a>
      </div>

      <dl class="readouts">
        <div class="readouts__item">
          <dt class="label">Papers</dt>
          <dd class="mono">{stats.papers}</dd>
        </div>
        <div class="readouts__item">
          <dt class="label">Accepted</dt>
          <dd class="mono">{stats.accepted}</dd>
        </div>
        <div class="readouts__item">
          <dt class="label">Revision needed</dt>
          <dd class="mono">{stats.declined}</dd>
        </div>
        <div class="readouts__item">
          <dt class="label">
            {stats.meanReadiness !== null ? "Mean readiness" : "Legacy panel mean"}
          </dt>
          <dd class="mono">
            {stats.meanReadiness !== null
              ? stats.meanReadiness.toFixed(1)
              : stats.meanScore !== null
                ? stats.meanScore.toFixed(2)
                : "N/A"}
            <span class="readouts__scale">
              {stats.meanReadiness !== null ? "/100" : "/5"}
            </span>
          </dd>
        </div>
      </dl>
      <p class="readouts__note">
        The Editor-in-Chief assigns publication readiness and a separate
        recommendation. The recommendation follows revision burden, not a score cutoff.
      </p>
    </div>
  </div>

  <div class="shell sections">
    <section class="why">
      <h2 class="h-section">The review is the artifact</h2>
      <div class="why__cols">
        <p>
          Referee reports are written once, read by three people, and thrown
          away.
        </p>
        <p>
          Here every submission that clears the desk gets five specialist
          reports, a recorded debate and an editor's verdict. The record is
          public, versioned, and reproducible down to the model that wrote each
          line.
        </p>
      </div>
    </section>

    <section class="pipeline">
      <div class="pipeline__head">
        <h2 class="h-section">What the panel does</h2>
        <p class="label">13 agents · two debate rounds</p>
      </div>
      <ol class="pipeline__list">
        {STAGES.map((s, i) => (
          <li class="stage">
            <span class="stage__n mono">{String(i + 1).padStart(2, "0")}</span>
            <span class="stage__name">{s.stage}</span>
            <span class="stage__who">{s.who}</span>
            <span class="stage__out mono">{s.out}</span>
          </li>
        ))}
      </ol>
      <p class="pipeline__note">
        Contribution and prior work queries arXiv, Semantic Scholar, PubMed and
        bioRxiv live. Each review publishes its own bill.
      </p>
    </section>

    {
      papers.length > 0 && (
        <section class="latest">
          <div class="latest__head">
            <h2 class="h-section">Most recent</h2>
            <a class="latest__all" href={`${base}/reviews/`}>All reviews →</a>
          </div>
          <ul class="latest__list">
            {papers.map((paper) => {
              const display = paper.decisive || paper.latest
              return (
                <li>
                  <a class="row" href={`${base}/reviews/${paper.year}/${paper.slug}/`}>
                    <span class={`verdict verdict--${paper.status}`}>
                      {STATUS[paper.status]}
                    </span>
                    <span class="row__title">{paper.title}</span>
                    <span class="row__score mono">
                      {display.readinessScore !== null
                        ? `${display.readinessScore}/100`
                        : display.meanScore !== null
                          ? `${display.meanScore.toFixed(1)}/5`
                          : "N/A"}
                    </span>
                  </a>
                </li>
              )
            })}
          </ul>
        </section>
      )
    }

    <section class="caveat">
      <h2 class="h-section">What this is not</h2>
      <div class="caveat__box">
        <p class="caveat__lead">
          Every recommendation here, including the verdict, was produced by a
          language model. No person read these papers and graded them. A human
          chooses only whether a review gets published at all.
        </p>
        <p>
          Not certification, not a substitute for peer review, not evidence a
          result is correct. It is a machine-generated second opinion, published
          so you can judge the reasoning yourself.
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(3rem, 9vw, 6.5rem) clamp(2.5rem, 6vw, 4rem);
  }

  /* A faint measurement grid, fading out from the top. The instrument the
     journal is named for, stated once and quietly. */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--rule) 1px, transparent 1px),
      linear-gradient(to bottom, var(--rule) 1px, transparent 1px);
    background-size: 68px 68px;
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 0%, transparent 78%);
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 0%, transparent 78%);
    opacity: 0.55;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .hero__eyebrow {
    color: var(--accent);
  }

  .hero__title {
    font-size: clamp(3.4rem, 13vw, 8rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    margin-block: 0.1rem 0.2rem;
  }

  .hero__lede {
    max-width: 46ch;
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    line-height: 1.55;
    color: var(--ink-dim);
  }

  .hero__lede em {
    color: var(--ink);
    font-style: italic;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.7rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--t--1);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-dim);
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-md);
    padding: 0.62rem 1.15rem;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }

  .btn:hover {
    color: var(--ink);
    border-color: var(--accent-dim);
  }

  .btn--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ground);
  }

  .btn--primary:hover {
    background: color-mix(in srgb, var(--accent) 85%, var(--ink));
    border-color: transparent;
    color: var(--ground);
  }

  .readouts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2.4rem;
    margin-top: 2.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
    width: 100%;
  }

  .readouts__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .readouts__item dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--ink);
  }

  .readouts__note {
    margin-top: 1rem;
    max-width: var(--measure);
    font-size: var(--t--1);
    color: var(--muted);
    line-height: 1.6;
  }

  .readouts__scale {
    font-family: var(--font-mono);
    font-size: var(--t--1);
    color: var(--muted);
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: clamp(2.6rem, 6vw, 4.2rem);
    padding-top: clamp(2.4rem, 6vw, 4rem);
  }

  .h-section {
    font-size: var(--t-3);
    margin-bottom: 0.9rem;
  }

  .why__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.2rem 2.4rem;
    color: var(--ink-dim);
    max-width: 78ch;
  }

  .pipeline__head,
  .latest__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .pipeline__head .h-section,
  .latest__head .h-section {
    margin-bottom: 0;
  }

  .pipeline__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .stage {
    display: grid;
    grid-template-columns: 2.6rem 7rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 1.1rem;
    background: var(--surface);
  }

  .stage + .stage {
    border-top: 1px solid var(--rule);
  }

  .stage__n {
    font-size: var(--t--2);
    color: var(--accent);
  }

  .stage__name {
    font-size: var(--t-0);
    font-weight: 600;
    color: var(--ink);
  }

  .stage__who {
    font-size: var(--t--1);
    color: var(--muted);
    line-height: 1.45;
  }

  .stage__out {
    font-size: var(--t--2);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-dim);
    text-align: right;
    white-space: nowrap;
  }

  .pipeline__note {
    margin-top: 0.9rem;
    max-width: 68ch;
    font-size: var(--t--1);
    color: var(--muted);
  }

  .latest__all {
    font-family: var(--font-mono);
    font-size: var(--t--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .latest__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .row:hover {
    border-color: var(--accent-dim);
    transform: translateX(3px);
  }

  .row__title {
    font-size: var(--t--1);
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row__score {
    font-size: var(--t--1);
    color: var(--muted);
  }

  .caveat__box {
    border: 1px solid var(--rule);
    border-left: 3px solid var(--v-major);
    border-radius: var(--r-lg);
    background: var(--surface);
    padding: 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    max-width: 72ch;
    color: var(--ink-dim);
  }

  .caveat__lead {
    color: var(--ink);
  }

  .caveat__kicker {
    font-family: var(--font-display);
    font-size: var(--t-1);
    color: var(--ink);
  }

  @media (max-width: 46rem) {
    .stage {
      grid-template-columns: 2.2rem minmax(0, 1fr);
      row-gap: 0.2rem;
    }
    .stage__who {
      grid-column: 2;
    }
    .stage__out {
      grid-column: 2;
      text-align: left;
      white-space: normal;
    }
    .readouts {
      gap: 1rem 1.8rem;
    }
    .row {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .row__score {
      display: none;
    }
    .row__title {
      white-space: normal;
    }
  }
</style>
