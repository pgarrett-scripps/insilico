---
/**
 * The things a reader has to be told before they read the review.
 *
 * Each of these exists because two situations that look identical on the page
 * are not the same evidence, and only saying so distinguishes them: a desk
 * rejection versus a considered one, a revision round that compared the drafts
 * versus one that couldn't, a review the authors asked for versus one attached
 * to their paper by a stranger.
 */
const { provenance } = Astro.props;

const VERDICT = {
  accept: "Accept",
  minor: "Minor revision",
  major: "Major revision",
  reject: "Reject",
};

const revision = provenance.revision || {};
const round = Number(provenance.round || 1);
const baseline = revision.baseline || {};
const claim = provenance.submitter_is_author || "";

const notices = [];

if (provenance.desk_rejected) {
  notices.push({
    tone: "danger",
    title: "Rejected at the desk — no referee panel was convened",
    body: [
      "Stopped before review, so there are no specialist reports below. The editor's reasoning is the whole record of this submission.",
    ],
  });
}

// A rerun is round 1 of the same draft under a changed pipeline. It has to
// announce itself, because a second bundle on a paper's page otherwise reads
// as a revision — as though the authors had done something, when the only
// thing that moved was us.
if (revision.kind === "rerun") {
  const body = [
    "The same draft, reviewed again after the pipeline changed. The authors revised nothing and the panel read the paper cold, so the difference between the two reviews is us, not the work.",
  ];
  if (revision.prior_decision) {
    body.push(
      `Earlier review: ${VERDICT[revision.prior_decision] || revision.prior_decision}` +
        (typeof revision.prior_mean_score === "number"
          ? `, mean ${revision.prior_mean_score}.`
          : "."),
    );
  }
  notices.push({ tone: "info", title: "Re-review under an updated pipeline", body });
}

if (round > 1) {
  const body = [
    "The authors revised the paper. Each referee rules on the points it raised, and an auditor checks the previous letter's required revisions against the new draft.",
  ];
  if (revision.prior_decision) {
    body.push(
      `The previous round recommended ${VERDICT[revision.prior_decision] || revision.prior_decision}.`,
    );
  }
  notices.push({ tone: "info", title: `Revision round ${round}`, body });

  if (!baseline.restored) {
    notices.push({
      tone: "warning",
      title: "No draft comparison in this round",
      body: [
        `The previously reviewed PDF could not be recovered (${baseline.reason || "reason unknown"}), so nothing here rests on a verified diff of what changed. The referees still rule on their earlier points.`,
      ],
    });
  }
}

if (claim === "no") {
  notices.push({
    tone: "warning",
    title: "The authors did not request this review",
    body: [
      "Submitted by someone with no connection to the paper. The authors were not consulted and have not replied. Authors: if this misreads your paper, open an issue and we will take it down.",
    ],
  });
} else if (claim === "yes") {
  notices.push({
    tone: "note",
    title: "Requested by the authors' side",
    body: ["Submitted by someone who states they are an author of this paper, or affiliated with it. We do not verify that claim."],
  });
} else {
  notices.push({
    tone: "note",
    title: "Solicitation unrecorded",
    body: [
      "This review predates our recording of who submitted it.",
    ],
  });
}
---

{
  notices.length > 0 && (
    <div class="notices">
      {notices.map((n) => (
        <aside class={`notice notice--${n.tone}`}>
          <p class="notice__title">{n.title}</p>
          {n.body.map((para) => (
            <p class="notice__body">{para}</p>
          ))}
        </aside>
      ))}
    </div>
  )
}

<style>
  .notices {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .notice {
    --tone: var(--muted);
    border: 1px solid color-mix(in srgb, var(--tone) 32%, var(--rule));
    border-left: 3px solid var(--tone);
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--tone) 6%, var(--surface));
    padding: 0.85rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .notice--danger { --tone: var(--v-reject); }
  .notice--warning { --tone: var(--v-major); }
  .notice--info { --tone: var(--accent); }
  .notice--note { --tone: var(--muted); }

  .notice__title {
    font-family: var(--font-mono);
    font-size: var(--t--2);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tone);
  }

  .notice__body {
    font-size: var(--t-0);
    line-height: 1.6;
    color: var(--ink-dim);
  }
</style>
