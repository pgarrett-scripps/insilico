---
/**
 * The things a reader has to be told before they read the review.
 *
 * Each of these exists because two situations that look identical on the page
 * are not the same evidence, and only saying so distinguishes them: a desk
 * rejection versus a considered one, a later round of a revised paper versus a
 * second read of the same draft, a review the authors asked for versus one
 * attached to their paper by a stranger.
 */
import { legacyScore100 } from "../lib/corpus.js";

const { provenance } = Astro.props;

const VERDICT = {
  accept: "Accept",
  minor: "Minor revision",
  major: "Major revision",
  reject: "Reject",
};

const revision = provenance.revision || {};
const review = provenance.review || {}
const round = Number(provenance.round || 1);
const claim = provenance.submitter_is_author || "";
const panelSize = Array.isArray(provenance.panel) ? provenance.panel.length : 0;
const reportCount = panelSize ? `${panelSize} reports` : "specialist reports";

// Whether the panel that wrote the reports below was told it was reading a
// revision. Those rounds carry `revision.baseline`: the status of the
// previously reviewed PDF, re-fetched so each referee could be handed a diff
// alongside its own prior report. The reports under them rule on prior points
// by id and open "Revision Review", so telling a reader they were written cold
// would misdescribe the record. A published bundle is never edited, so the
// bundle decides which account of itself it gets.
const sawPriorRound = Boolean(revision.baseline);

const notices: {tone: string, title: string, body: string[]}[] = [];

if (provenance.desk_rejected) {
  notices.push({
    tone: "danger",
    title: "Rejected at the desk: no referee panel was convened",
    body: [
      "Stopped before review, so there are no specialist reports below. The editor's reasoning is the whole record of this submission.",
    ],
  });
}

// A rerun is round 1 of the same draft under a changed pipeline. It has to
// announce itself because a second bundle on a paper's page otherwise reads
// as a revision. That would imply the authors had changed something when only
// the review pipeline changed.
if (revision.kind === "rerun") {
  const body = [
    "The same draft, reviewed again after the pipeline changed. The authors revised nothing, and nothing from the earlier review reached this one, so the difference between the two is us, not the work.",
  ];
  if (revision.prior_decision) {
    body.push(
        `Earlier review: ${VERDICT[revision.prior_decision] || revision.prior_decision}` +
        (typeof revision.prior_mean_score === "number"
          ? `, legacy scaled score ${legacyScore100(revision.prior_mean_score)}/100.`
          : "."),
    );
  }
  notices.push({ tone: "info", title: "Re-review under an updated pipeline", body });
}

if (review.kind === "experiment" || review.baseline_eligible === false) {
  notices.push({
    tone: "warning",
    title: "Supplementary review",
    body: [
      "This run is published for comparison. It does not define the paper's editorial status and will not become the baseline for a later manuscript revision.",
    ],
  })
}

if (round > 1) {
  const body = sawPriorRound
    ? [
        "The authors revised the paper. Each referee below was shown its own report from the previous round and ruled on every point it had raised, and an auditor checked the previous letter's required revisions against the new draft.",
      ]
    : [
        `The authors revised the paper. Every referee below read this draft cold: none was told that a previous round exists, so the ${reportCount} are an independent read of the paper as it stands rather than a verdict on the revisions. A referee restating a concern is not evidence the authors ignored it, and score movement between rounds carries the noise of a fresh panel.`,
        "What crosses rounds is the editor's numbered required revisions. An auditor rules on each one against the new draft and cannot call an item addressed without quoting manuscript text that is checked to be there, so the compliance report and the decision letter are the account of what happened to the asks.",
      ];
  if (revision.prior_decision) {
    body.push(
      `The previous round recommended ${VERDICT[revision.prior_decision] || revision.prior_decision}.`,
    );
  }
  notices.push({ tone: "info", title: `Revision round ${round}`, body });

  // This round predates the blind panel, and the difference changes what the
  // progress claims below are worth. Telling a referee it is judging a
  // revision gives it a reason to find progress: on a byte-identical
  // resubmission that arrangement produced a raised score "because the
  // revision successfully addresses the concerns" and an audit describing an
  // expanded methods section that was not in the paper.
  if (sawPriorRound) {
    notices.push({
      tone: "warning",
      title: "The panel knew it was reading a revision",
      body: [
        "Later rounds are reviewed blind, for a reason that applies to this page: a referee that has been handed its own earlier complaints is being asked whether they were met, not whether the paper is sound. Read what the reports below call resolved against the manuscript, not against the previous round.",
      ],
    });
  }
}

if (claim === "no") {
  notices.push({
    tone: "warning",
    title: "The authors did not request this review",
    body: [
      "Submitted by someone with no connection to the paper. The authors were not consulted and have not replied. Authors: if this misreads your paper, open an issue and we will take it down.",
    ],
  });
} else if (claim === "yes") {
  notices.push({
    tone: "note",
    title: "Requested by the authors' side",
    body: ["Submitted by someone who states they are an author of this paper, or affiliated with it. We do not verify that claim."],
  });
} else {
  notices.push({
    tone: "note",
    title: "Solicitation unrecorded",
    body: [
      "This review predates our recording of who submitted it.",
    ],
  });
}
---

{
  notices.length > 0 && (
    <div class="notices">
      {notices.map((n) => (
        <aside class={`notice notice--${n.tone}`}>
          <p class="notice__title">{n.title}</p>
          {n.body.map((para) => (
            <p class="notice__body">{para}</p>
          ))}
        </aside>
      ))}
    </div>
  )
}

<style>
  .notices {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .notice {
    --tone: var(--muted);
    border: 1px solid color-mix(in srgb, var(--tone) 32%, var(--rule));
    border-left: 3px solid var(--tone);
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--tone) 6%, var(--surface));
    padding: 0.85rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .notice--danger { --tone: var(--v-reject); }
  .notice--warning { --tone: var(--v-major); }
  .notice--info { --tone: var(--accent); }
  .notice--note { --tone: var(--muted); }

  .notice__title {
    font-family: var(--font-mono);
    font-size: var(--t--2);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tone);
  }

  .notice__body {
    font-size: var(--t-0);
    line-height: 1.6;
    color: var(--ink-dim);
  }
</style>
