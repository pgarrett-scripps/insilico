---
/**
 * What produced this review, in enough detail to reproduce or dispute it.
 *
 * A machine-generated review is only worth as much as its accounting. The
 * verdict is an opinion; the model that wrote each report, the exact bytes it
 * read, and what the run cost are facts, and publishing them is what lets a
 * reader check the review rather than trust it.
 */
const { provenance } = Astro.props;

const TAG_LABEL = {
  reviewer: "Specialist reviewers (×5) + desk screen",
  audit: "Editorial audits (×2)",
  debate: "Advocate / skeptic",
  synthesis: "Editor, debate synthesizer",
};

const pipeline = provenance.pipeline || {};
const insilico = provenance.insilico || {}
const configuration = provenance.configuration || {}
const journalProfile = provenance.journal_profile || {}
const review = provenance.review || {}
// Text the publishing editor read in a refusal and allowed onto the page. The
// leak scan refuses a path or an address by default, and an editor can overrule
// it for a string that is the review's own words. That overruling is a judgement
// a reader is entitled to see, so it is printed here rather than being recorded
// only in the JSON.
const allowedText = Array.isArray(review.allowed_text) ? review.allowed_text : [];
const preprint = provenance.preprint || {};
const fallback = provenance.model || "unspecified";
const modelName = (value: string | {model?: string}) =>
  typeof value === "object" && value !== null && "model" in value
    ? value.model
    : value;

// The hosted panel's table, keyed by the stage tags that panel used. A plugin
// run keys `models` by agent slot instead, and its table is built from the
// generator's agent rows below, which also know each slot's role and track.
const modelRows = provenance.generator
  ? []
  : [
      ...Object.entries(provenance.models || {}).map(([tag, v]) => ({
        stage: TAG_LABEL[tag] || tag,
        model: modelName(v) || fallback,
      })),
      ...Object.entries(provenance.agent_models || {}).map(([agent, v]) => ({
        stage: `${agent.replace(/_/g, " ")} (override)`,
        model: modelName(v) || fallback,
      })),
    ];

// An empty model table means no per-stage split ran: every agent, from the
// desk screen to the editor, used one model. That is a different artifact
// from the graded panel the rest of the corpus records. The verdict was
// decided by whatever reviewed the paper, with no stronger model checking it,
// and a reader comparing two reviews needs to see that before comparing them.
const singleModel = !provenance.generator && modelRows.length === 0 && provenance.model
  ? provenance.model
  : null;

// What the referees looked up. The site says elsewhere that novelty and
// literature search live rather than working from recall; this is the only
// thing published that shows it happened, and the only thing that can show a
// referee fell back to reviewing without research tools. Absent on every
// review that predates the measurement, and silent there rather than claiming
// zero searches.
const research = Object.entries(provenance.research_by_node || {})
  .map(([node, calls]) => {
    const list = Array.isArray(calls) ? calls : [];
    return {
      node: node.replace(/_/g, " "),
      calls: list.filter((c) => c && c.tool),
      // An entry with an error and no tool name is the tool loop failing over,
      // not a search that returned nothing.
      lost: list.filter((c) => c && c.error && !c.tool).length,
      hits: list.reduce((n, c) => n + (Number(c?.hits) || 0), 0),
    };
  })
  .filter((r) => r.calls.length || r.lost);

const searchCount = research.reduce((n, r) => n + r.calls.length, 0);
const degraded = research.filter((r) => r.lost);

const costs = Object.entries(provenance.cost_by_node || {})
  .map(([node, usd]) => ({ node: node.replace(/_/g, " "), usd: Number(usd) }))
  .sort((a, b) => b.usd - a.usd);

const total = typeof provenance.total_cost_usd === "number" ? provenance.total_cost_usd : null;
const screens = provenance.screens || {};

// What the referees were actually handed. The PDF is the citable artifact and
// keeps its fingerprint above, but the panel reads a rendering of it. Under
// compression a quoted sentence is missing its articles and copulas.
// Someone checking a quotation against the paper needs to know that before
// concluding the referee misquoted it.
const ingest = provenance.ingest || {};
const ingestNote = ingest.format === "markdown"
  ? (ingest.caveman
      ? `Converted by ${ingest.tool}, then compressed. Quotations are shortened and will not match the PDF word for word.`
      : `Converted by ${ingest.tool}. Quotations match the manuscript text.`)
  : ingest.tool
    ? `Read by ${ingest.tool}.`
    : "Not recorded. This review predates the ingest record.";

// How well that conversion went, measured at ingest with no model involved.
// Shown only when it went imperfectly: a badge reading "clean" on every review
// teaches a reader to stop looking at the place the warning would appear.
// A conversion worse than this never reaches the panel, so nothing published
// here was reviewed as gibberish.
const health = (ingest.prose || {}).health || {};
const conversion = health.verdict && health.verdict !== "clean"
  ? { verdict: health.verdict, notes: health.notes || [] }
  : null;
// A review generated on the editor's own machine, on a subscription, and
// uploaded as a pull request. The hosted panel's accounting does not exist for
// one of these: there is no five-reviewer split and no dollar figure. What
// replaces it is this block, and the facts a reader most needs from it are
// that the engine and the plugin are pinned by hash, which agents ran on which
// model, whether every reader the arm asked for reported, and that the verdict
// was a person's rather than the model's. Absent on every version 2 record,
// and silent there.
const generator = provenance.generator || null;
const engine = generator?.engine || {};
const engineHash = generator?.engine_fingerprint || {};
const transport = generator?.transport || {};
const plugin = generator?.plugin || {};
const pluginHash = plugin.fingerprint || {};
const input = generator?.input || {};
const runRecord = generator?.run || {};
const attestation = generator?.attestation || {};
const advisory = generator?.advisory_verdict || {};

// One row per agent that ran, with the model its plugin agent file pinned. The
// plugin pins a model per agent rather than per stage, so this is the table
// that says what wrote which part of the review. The harness's unfilled
// placeholder rows are dropped where the record is built, not here.
const agentRows = (Array.isArray(generator?.agents) ? generator.agents : []).map((row) => ({
  slot: String(row.slot || ""),
  role: String(row.role || row.agent_type || "").replace(/^pra:/, "").replace(/[_-]/g, " "),
  track: String(row.track || ""),
  model: String(row.model || ""),
  toolCalls: typeof row.tool_calls === "number" ? row.tool_calls : null,
  attempt: typeof row.attempt === "number" ? row.attempt : null,
  findings: typeof row.findings === "number" ? row.findings : null,
  noneFound: row.none_found === true,
}));

// Agents pinned to the same model are not independent of one another, however
// many of them read the manuscript. When one model ran the whole panel, that is
// the heaviest caveat on the page and it goes above the tables rather than in
// one.
const agentModels = [...new Set(agentRows.map((row) => row.model).filter(Boolean))];
const oneModelRan = agentRows.length > 1 && agentModels.length === 1
  ? agentModels[0]
  : null;

// The stage ledger. Publishing refuses a run with a missing stage, so the
// interesting rows here are the readers that reported nothing and the ones that
// had to be retried: both are facts about how much of this review is one pass.
const ledger = runRecord.completeness || {};
const requiredStages = Array.isArray(ledger.required) ? ledger.required : [];
const reportedStages = Array.isArray(ledger.reported) ? ledger.reported : [];
const noneFound = Array.isArray(ledger.none_found) ? ledger.none_found : [];
const retried = Array.isArray(ledger.retried) ? ledger.retried : [];
const quarantined = typeof runRecord.quarantined_findings_count === "number"
  ? runRecord.quarantined_findings_count
  : 0;
const specialists = Array.isArray(runRecord.specialist_tracks) ? runRecord.specialist_tracks : [];
const advisoryRows = [
  ["Significance", advisory.significance],
  ["Strength of evidence", advisory.strength_of_evidence],
  ["Reasoning", advisory.reasoning],
  ["What it rests on", advisory.basis],
  ["Stated limitation", advisory.limitation],
].filter(([, value]) => String(value || "").trim());

// Where the reviewed bytes came from. With a local file the hash is still the
// hash of what the engine read, but a reader cannot fetch the identifier and
// reproduce it, because the operator supplied the PDF from their own disk. That
// is a weaker claim than a fetched preprint and has to look like one.
const localFile = input.local_file === true;
const sourceOfBytes = input.local_file === undefined
  ? "source unrecorded"
  : localFile
    ? "supplied locally"
    : "fetched from the identifier";

const sha = pipeline.sha ? String(pipeline.sha).slice(0, 8) : "";
const journalSha = journalProfile.sha256 ? String(journalProfile.sha256).slice(0, 12) : ""
const configSha = configuration.sha256 ? String(configuration.sha256).slice(0, 12) : ""
const insilicoSha = insilico.sha ? String(insilico.sha).slice(0, 8) : ""
---

<section class="prov panel" aria-labelledby="prov-heading">
  <div class="panel__head">
    <h2 id="prov-heading" class="prov__title">Provenance</h2>
    <p class="label">
      <a href="https://doi.org/10.5281/zenodo.21781895">PeerReviewAgents</a>
      {" "}{pipeline.version || "unknown"}
      {sha && <span> · {sha}</span>}
    </p>
  </div>

  <div class="prov__grid">
    {review.manuscript_version && (
      <div class="prov__cell">
        <p class="label">Review record</p>
        <p class="prov__value mono">
          v{review.manuscript_version}/r{review.attempt || 1}
        </p>
        <p class="prov__hash">{String(review.kind || "editorial").replace(/_/g, " ")}</p>
      </div>
    )}

    {generator && (
      <div class="prov__cell">
        <p class="label">Generated</p>
        <p class="prov__value mono">locally, on a subscription</p>
        <p class="prov__hash">
          {transport.provider || "unknown transport"} via
          {" "}<span class="mono">{transport.executable || "unknown"}</span>
          {transport.version ? ` ${transport.version}` : ""}
          . No paid API key was used.
        </p>
      </div>
    )}

    {generator && (
      <div class="prov__cell">
        <p class="label">Review engine</p>
        <p class="prov__value mono">
          {engine.name || "unknown"} {engine.version || ""}
        </p>
        {engineHash.sha256 && (
          <p class="prov__hash mono" title={engineHash.sha256}>
            {engineHash.file_count} files, sha256 {String(engineHash.sha256).slice(0, 16)}…
          </p>
        )}
      </div>
    )}

    {generator && (pluginHash.sha256 || plugin.workflow_sha256) && (
      <div class="prov__cell">
        <p class="label">Review plugin</p>
        <p class="prov__value mono">
          workflow {plugin.workflow_version || "unversioned"}
          {plugin.finding_schema_version
            ? ` · findings ${plugin.finding_schema_version}`
            : ""}
        </p>
        {pluginHash.sha256 && (
          <p class="prov__hash mono" title={pluginHash.sha256}>
            {pluginHash.file_count} files, sha256 {String(pluginHash.sha256).slice(0, 16)}…
          </p>
        )}
        {plugin.workflow_sha256 && (
          <p class="prov__hash mono" title={plugin.workflow_sha256}>
            workflow sha256 {String(plugin.workflow_sha256).slice(0, 16)}…
          </p>
        )}
      </div>
    )}

    {generator && (
      <div class="prov__cell">
        <p class="label">Input reviewed</p>
        <p class="prov__value mono">
          {input.kind || "unrecorded"}
          {input.bytes ? ` · ${(input.bytes / 1024).toFixed(0)} KiB` : ""}
        </p>
        {input.sha256 && (
          <p class="prov__hash mono" title={input.sha256}>
            sha256 {String(input.sha256).slice(0, 24)}…
          </p>
        )}
        <p class="prov__hash">{sourceOfBytes}</p>
      </div>
    )}

    {generator && runRecord.arm && (
      <div class="prov__cell">
        <p class="label">Run</p>
        <p class="prov__value mono">
          {runRecord.arm}
          {runRecord.reviewers ? ` · ${runRecord.reviewers} reviewer${runRecord.reviewers === 1 ? "" : "s"}` : ""}
          {specialists.length > 0 ? ` · ${specialists.length} specialist${specialists.length === 1 ? "" : "s"}` : ""}
        </p>
        <p class="prov__hash">
          {typeof runRecord.findings === "number"
            ? `${runRecord.findings} finding${runRecord.findings === 1 ? "" : "s"} in the letter`
            : "finding count unrecorded"}
          {typeof runRecord.appendix_findings === "number" && runRecord.appendix_findings > 0
            ? `, ${runRecord.appendix_findings} in the appendix`
            : ""}
          {runRecord.escalated_in_bundle
            ? `, ${runRecord.escalated_in_bundle} escalated`
            : ""}
          {runRecord.literature_cutoff ? `, literature to ${runRecord.literature_cutoff}` : ""}
        </p>
        {/* A finding the evidence guards threw out never reaches the letter, and
            a reader weighing the review should see how many were thrown out
            rather than only how many survived. The row itself is in the
            bundle: review_package carries quarantined_findings into
            editor-package.json, so saying it is not in the bundle sent a
            reader looking for something they already had. */}
        {quarantined > 0 && (
          <p class="prov__hash">
            {quarantined} finding{quarantined === 1 ? " was" : "s were"} quarantined
            by the evidence guards and held out of the decision letter.
            {quarantined === 1 ? " It is" : " They are"} in this bundle's
            editor-package.json under quarantined_findings.
          </p>
        )}
        {/* A review with nothing in it is a result, and "0 findings in the
            letter" on its own reads like a run that broke. The engine
            finishes such a run as complete-without-findings and publishes it
            like any other review, so the panel says what it means. A review
            the guards emptied reaches the same status and is refused at
            publish, which is why the sentence is held back when anything was
            quarantined. */}
        {runRecord.findings === 0 && !runRecord.appendix_findings && quarantined === 0 && (
          <p class="prov__hash">
            The reviewers raised no make-or-break findings against this
            manuscript.
          </p>
        )}
      </div>
    )}

    <div class="prov__cell">
      <p class="label">Reviewed file</p>
      <p class="prov__value mono">
        {preprint.version ? `v${preprint.version}` : "version unrecorded"}
        {preprint.pdf_bytes ? ` · ${(preprint.pdf_bytes / 1024).toFixed(0)} KiB` : ""}
      </p>
      {preprint.pdf_sha256 && (
        <p class="prov__hash mono" title={preprint.pdf_sha256}>
          sha256 {preprint.pdf_sha256.slice(0, 24)}…
        </p>
      )}
    </div>

    {/* A local run records no debate round count. Showing "N/A" for a number
        the hosted panel measured and this path never had would read as a
        missing measurement rather than an absent stage. */}
    {provenance.debate_rounds != null && (
      <div class="prov__cell">
        <p class="label">Debate rounds</p>
        <p class="prov__value mono">{provenance.debate_rounds ?? "N/A"}</p>
      </div>
    )}

    {total !== null && (
      <div class="prov__cell">
        <p class="label">Run cost</p>
        <p class="prov__value mono">${total.toFixed(2)}</p>
      </div>
    )}

    <div class="prov__cell">
      <p class="label">Manuscript read as</p>
      <p class="prov__value mono">
        {ingest.format === "markdown" ? "markdown" : ingest.format || "unrecorded"}
        {ingest.caveman ? ` · ${ingest.caveman}` : ""}
      </p>
      <p class="prov__hash">{ingestNote}</p>
      {conversion && (
        <p class="prov__warn">
          Conversion {conversion.verdict}: {conversion.notes.join(". ")}. The
          panel read damaged text, and the damage is the converter's, not the
          authors'.
        </p>
      )}
    </div>

    {screens.desk_screen_mode && (
      <div class="prov__cell">
        <p class="label">Desk screen</p>
        <p class="prov__value mono">triage {screens.desk_screen_mode}</p>
      </div>
    )}

    {insilicoSha && (
      <div class="prov__cell">
        <p class="label">In Silico commit</p>
        <p class="prov__value mono" title={insilico.sha}>{insilicoSha}</p>
      </div>
    )}

    {configSha && (
      <div class="prov__cell">
        <p class="label">Configuration</p>
        <p class="prov__value mono" title={configuration.sha256}>sha256 {configSha}</p>
      </div>
    )}

    {journalSha && (
      <div class="prov__cell">
        <p class="label">Journal profile</p>
        <p class="prov__value mono">{journalProfile.journal || "unspecified"}</p>
        <p class="prov__hash mono" title={journalProfile.sha256}>sha256 {journalSha}</p>
      </div>
    )}
  </div>

  {allowedText.length > 0 && (
    <p class="prov__warn prov__warn--block">
      <strong>The editor allowed text the leak scan had refused:</strong>{" "}
      <span class="mono">{allowedText.join("  ")}</span>
    </p>
  )}

  {generator && (
    <p class="prov__warn prov__warn--block">
      <strong>The decision on this review is a person's, not a model's.</strong>{" "}
      The engine grades findings and recommends no verdict, so the decision above
      was chosen by{" "}
      {attestation.editor
        ? <span class="mono">{attestation.editor}</span>
        : "a human editor"}
      {attestation.human_reviewed_before_merge === true
        ? ", who read the run before taking it, and publishing it required that editor to merge it."
        : ". Whether that editor read the run before taking the decision is not recorded here, so read it as a decision taken on the engine's reports."}
      {attestation.statement && (
        <span class="prov__attest">{attestation.statement}</span>
      )}
    </p>
  )}

  {generator && localFile && (
    <p class="prov__warn prov__warn--block">
      <strong>The manuscript file was supplied by the operator, not fetched.</strong>{" "}
      The hash above is of the exact bytes the engine read, but those bytes came
      from the editor's own disk rather than from{" "}
      <span class="mono">{input.identifier || "the identifier"}</span>. A reader
      cannot download the identifier and reproduce the hash, so take it as a
      record of what was reviewed and not as proof of which revision it was.
    </p>
  )}

  {oneModelRan && (
    <p class="prov__warn prov__warn--block">
      <strong>One model wrote this entire review.</strong> All{" "}
      {agentRows.length} agents ran on{" "}
      <span class="mono">{oneModelRan}</span>. Agents that share a model are not
      independent corroboration of one another, so read agreement between them
      as one reader repeating itself rather than as several readers concurring.
    </p>
  )}

  {generator && retried.length > 0 && (
    <p class="prov__warn prov__warn--block">
      <strong>A reader had to be run more than once.</strong>{" "}
      {retried.join(", ")} did not report on the first attempt and was retried.
      The report published is the attempt that answered, and the earlier ones
      are in the run folder rather than here.
    </p>
  )}

  {generator && advisoryRows.length > 0 && (
    <details class="prov__more">
      <summary>The engine's own judgement, which decided nothing</summary>
      <div class="table-scroll">
        <table class="prov__table">
          <tbody>
            {advisoryRows.map(([label, value]) => (
              <tr>
                <td>{label}</td>
                <td>{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="prov__note">
        Advisory only. The editor agent grades significance and strength of
        evidence and recommends no verdict, and the decision on this review was
        taken by a person who was free to disagree with every line of it.
      </p>
    </details>
  )}

  {agentRows.length > 0 && (
    <details class="prov__more">
      <summary>Which model wrote which part</summary>
      <div class="table-scroll">
        <table class="prov__table">
          <thead>
            <tr>
              <th>Agent</th><th>Track</th><th>Model</th><th>Findings</th><th>Tool calls</th>
            </tr>
          </thead>
          <tbody>
            {agentRows.map((row) => (
              <tr>
                <td>{row.role || row.slot}</td>
                <td class="mono">{row.track || "N/A"}</td>
                <td class="mono">{row.model || "unrecorded"}</td>
                <td class="mono">
                  {row.noneFound
                    ? "none found"
                    : row.findings == null ? "N/A" : row.findings}
                </td>
                <td class="mono">{row.toolCalls == null ? "N/A" : row.toolCalls}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="prov__note">
        Each agent's model is pinned by its own file in the plugin, not chosen at
        run time. These are the models the run reported having used, read back
        out of the harness record rather than out of the request.
      </p>
    </details>
  )}

  {generator && requiredStages.length > 0 && (
    <details class="prov__more">
      <summary>
        Every reader the arm asked for
        {` (${reportedStages.length} of ${requiredStages.length} reported)`}
      </summary>
      <div class="table-scroll">
        <table class="prov__table">
          <thead>
            <tr><th>Stage</th><th>Reported</th></tr>
          </thead>
          <tbody>
            {requiredStages.map((stage) => (
              <tr>
                <td class="mono">{stage}</td>
                <td>
                  {!reportedStages.includes(stage)
                    ? "no report"
                    : noneFound.includes(stage)
                      ? "reported, found nothing"
                      : "reported"}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="prov__note">
        A reader that found nothing is a result, not a gap. Publishing refuses a
        run with a stage that never reported at all, so this table exists to let
        a reader check that claim rather than take it.
      </p>
    </details>
  )}

  {singleModel && (
    <p class="prov__warn prov__warn--block">
      <strong>One model wrote this entire review.</strong> Every agent ran on
      <span class="mono">{singleModel}</span>. Most reviews here use a graded
      panel where a stronger model decides the verdict; this one did not, so
      nothing checked the referees that was any better than them.
    </p>
  )}

  {modelRows.length > 0 && (
    <details class="prov__more">
      <summary>Which model wrote which report</summary>
      <div class="table-scroll">
        <table class="prov__table">
          <thead>
            <tr><th>Stage</th><th>Model</th></tr>
          </thead>
          <tbody>
            {modelRows.map((r) => (
              <tr>
                <td>{r.stage}</td>
                <td class="mono">{r.model}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="prov__note">
        The widest fan-out runs on the cheapest model. Only the agents that
        decide the verdict run on the most capable one.
      </p>
    </details>
  )}

  {degraded.length > 0 && (
    <p class="prov__warn prov__warn--block">
      <strong>A referee reviewed without its research tools.</strong>{" "}
      {degraded.map((r) => r.node).join(", ")} lost the literature lookup and
      judged prior work from the manuscript and recall alone. Read its claims
      about what does and does not already exist with that in mind.
    </p>
  )}

  {research.length > 0 && (
    <details class="prov__more">
      <summary>
        What the referees looked up
        {searchCount > 0 && ` (${searchCount} search${searchCount === 1 ? "" : "es"})`}
      </summary>
      <div class="table-scroll">
        <table class="prov__table">
          <thead>
            <tr><th>Agent</th><th>Search</th><th>Answered by</th><th>Hits</th></tr>
          </thead>
          <tbody>
            {research.flatMap((r) =>
              r.calls.map((c, i) => (
                <tr>
                  <td>{i === 0 ? r.node : ""}</td>
                  <td>
                    <span class="mono prov__tool">{c.tool.replace(/_/g, " ")}</span>
                    {c.query && <span class="prov__query">{c.query}</span>}
                  </td>
                  {/* Which database actually answered. The router falls back on
                      a rate limit, and a related-work query served by arXiv
                      rather than Semantic Scholar has searched the wrong corpus
                      for anything outside physics and computer science. */}
                  <td class="mono prov__vendor">{c.vendor || "N/A"}</td>
                  <td class="mono">{Number(c.hits) || 0}</td>
                </tr>
              )),
            )}
          </tbody>
        </table>
      </div>
      <p class="prov__note">
        Run against arXiv, Semantic Scholar, PubMed and bioRxiv while the review
        was being written. A search returning zero hits is kept: it is the
        evidence behind a referee saying it found no prior art.
      </p>
    </details>
  )}

  {costs.length > 0 && (
    <details class="prov__more">
      <summary>What each agent cost</summary>
      <div class="table-scroll">
        <table class="prov__table">
          <thead>
            <tr><th>Agent</th><th>USD</th></tr>
          </thead>
          <tbody>
            {costs.map((c) => (
              <tr>
                <td>{c.node}</td>
                <td class="mono">${c.usd.toFixed(4)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}
</section>

