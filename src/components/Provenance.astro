---
/**
 * What produced this review, in enough detail to reproduce or dispute it.
 *
 * A machine-generated review is only worth as much as its accounting. The
 * verdict is an opinion; the model that wrote each report, the exact bytes it
 * read, and what the run cost are facts, and publishing them is what lets a
 * reader check the review rather than trust it.
 */
const { provenance } = Astro.props;

const TAG_LABEL = {
  reviewer: "Specialist reviewers (×8) + desk screen",
  audit: "Editorial audits (×2)",
  debate: "Advocate / skeptic",
  synthesis: "Area chair, rebuttal, editor, venue scout",
};

const pipeline = provenance.pipeline || {};
const preprint = provenance.preprint || {};
const fallback = provenance.model || "unspecified";

const modelRows = [
  ...Object.entries(provenance.models || {}).map(([tag, v]) => ({
    stage: TAG_LABEL[tag] || tag,
    model: (typeof v === "object" ? v.model : v) || fallback,
  })),
  ...Object.entries(provenance.agent_models || {}).map(([agent, v]) => ({
    stage: `${agent.replace(/_/g, " ")} (override)`,
    model: (typeof v === "object" ? v.model : v) || fallback,
  })),
];

// An empty model table means no per-stage split ran: every agent, from the
// desk screen to the editor, used one model. That is a different artifact
// from the graded panel the rest of the corpus records — the verdict was
// decided by whatever reviewed the paper, with no stronger model checking it —
// and a reader comparing two reviews needs to see that before comparing them.
const singleModel = modelRows.length === 0 && provenance.model
  ? provenance.model
  : null;

const costs = Object.entries(provenance.cost_by_node || {})
  .map(([node, usd]) => ({ node: node.replace(/_/g, " "), usd: Number(usd) }))
  .sort((a, b) => b.usd - a.usd);

const total = typeof provenance.total_cost_usd === "number" ? provenance.total_cost_usd : null;
const screens = provenance.screens || {};

// What the referees were actually handed. The PDF is the citable artifact and
// keeps its fingerprint above, but the panel reads a rendering of it — and
// under compression a quoted sentence is missing its articles and copulas.
// Someone checking a quotation against the paper needs to know that before
// concluding the referee misquoted it.
const ingest = provenance.ingest || {};
const ingestNote = ingest.format === "markdown"
  ? (ingest.caveman
      ? `Converted by ${ingest.tool}, then compressed. Quotations are shortened and will not match the PDF word for word.`
      : `Converted by ${ingest.tool}. Quotations match the manuscript text.`)
  : ingest.tool
    ? `Read by ${ingest.tool}.`
    : "Not recorded. This review predates the ingest record.";

// How well that conversion went, measured at ingest with no model involved.
// Shown only when it went imperfectly: a badge reading "clean" on every review
// teaches a reader to stop looking at the place the warning would appear.
// A conversion worse than this never reaches the panel, so nothing published
// here was reviewed as gibberish.
const health = (ingest.prose || {}).health || {};
const conversion = health.verdict && health.verdict !== "clean"
  ? { verdict: health.verdict, notes: health.notes || [] }
  : null;
const sha = pipeline.sha ? String(pipeline.sha).slice(0, 8) : "";
---

<section class="prov panel" aria-labelledby="prov-heading">
  <div class="panel__head">
    <h2 id="prov-heading" class="prov__title">Provenance</h2>
    <p class="label">
      <a href="https://doi.org/10.5281/zenodo.21781895">PeerReviewAgents</a>
      {" "}{pipeline.version || "unknown"}
      {sha && <span> · {sha}</span>}
    </p>
  </div>

  <div class="prov__grid">
    <div class="prov__cell">
      <p class="label">Reviewed file</p>
      <p class="prov__value mono">
        {preprint.version ? `v${preprint.version}` : "version unrecorded"}
        {preprint.pdf_bytes ? ` · ${(preprint.pdf_bytes / 1024).toFixed(0)} KiB` : ""}
      </p>
      {preprint.pdf_sha256 && (
        <p class="prov__hash mono" title={preprint.pdf_sha256}>
          sha256 {preprint.pdf_sha256.slice(0, 24)}…
        </p>
      )}
    </div>

    <div class="prov__cell">
      <p class="label">Debate rounds</p>
      <p class="prov__value mono">{provenance.debate_rounds ?? "—"}</p>
    </div>

    {total !== null && (
      <div class="prov__cell">
        <p class="label">Run cost</p>
        <p class="prov__value mono">${total.toFixed(2)}</p>
      </div>
    )}

    <div class="prov__cell">
      <p class="label">Manuscript read as</p>
      <p class="prov__value mono">
        {ingest.format === "markdown" ? "markdown" : ingest.format || "unrecorded"}
        {ingest.caveman ? ` · ${ingest.caveman}` : ""}
      </p>
      <p class="prov__hash">{ingestNote}</p>
      {conversion && (
        <p class="prov__warn">
          Conversion {conversion.verdict}: {conversion.notes.join("; ")}. The
          panel read damaged text, and the damage is the converter's, not the
          authors'.
        </p>
      )}
    </div>

    <div class="prov__cell">
      <p class="label">Desk screens</p>
      <p class="prov__value mono">
        {screens.injection_screen ? "integrity on" : "integrity off"}
        {screens.desk_screen_mode ? ` · triage ${screens.desk_screen_mode}` : ""}
      </p>
    </div>
  </div>

  {singleModel && (
    <p class="prov__warn prov__warn--block">
      <strong>One model wrote this entire review.</strong> Every agent ran on
      <span class="mono">{singleModel}</span>. Most reviews here use a graded
      panel where a stronger model decides the verdict; this one did not, so
      nothing checked the referees that was any better than them.
    </p>
  )}

  {modelRows.length > 0 && (
    <details class="prov__more">
      <summary>Which model wrote which report</summary>
      <div class="table-scroll">
        <table class="prov__table">
          <thead>
            <tr><th>Stage</th><th>Model</th></tr>
          </thead>
          <tbody>
            {modelRows.map((r) => (
              <tr>
                <td>{r.stage}</td>
                <td class="mono">{r.model}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="prov__note">
        The widest fan-out runs on the cheapest model; only the agents that
        decide the verdict run on the most capable one.
      </p>
    </details>
  )}

  {costs.length > 0 && (
    <details class="prov__more">
      <summary>What each agent cost</summary>
      <div class="table-scroll">
        <table class="prov__table">
          <thead>
            <tr><th>Agent</th><th>USD</th></tr>
          </thead>
          <tbody>
            {costs.map((c) => (
              <tr>
                <td>{c.node}</td>
                <td class="mono">${c.usd.toFixed(4)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}
</section>

<style>
  .prov__title {
    font-size: var(--t-1);
  }

  .prov__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .prov__cell {
    padding: 0.9rem 1.15rem;
    border-bottom: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .prov__value {
    font-size: var(--t-0);
    color: var(--ink);
  }

  .prov__hash {
    font-size: var(--t--2);
    color: var(--muted);
    word-break: break-all;
  }

  /* Rare by construction — only a review whose manuscript converted badly
     carries one, and the accent rule is there to stop it reading as another
     line of provenance boilerplate. */
  .prov__warn {
    margin-top: 0.5rem;
    padding-left: 0.6rem;
    border-left: 2px solid var(--accent);
    font-size: var(--t--2);
    color: var(--ink-dim);
  }

  /* The same rule, promoted out of a grid cell to span the panel. A
     single-model run changes how every other number here should be read, so
     it sits above the tables rather than inside one of them. */
  .prov__warn--block {
    margin: 1rem 0 0;
    padding: 0.7rem 0.9rem;
    border-left-width: 3px;
    background: var(--accent-glow);
    line-height: 1.5;
  }

  .prov__more {
    border-bottom: 1px solid var(--rule);
  }

  .prov__more:last-child {
    border-bottom: 0;
  }

  .prov__more > summary {
    cursor: pointer;
    padding: 0.7rem 1.15rem;
    font-family: var(--font-mono);
    font-size: var(--t--1);
    color: var(--ink-dim);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .prov__more > summary::-webkit-details-marker {
    display: none;
  }

  .prov__more > summary::before {
    content: "+";
    color: var(--accent);
    font-weight: 600;
  }

  .prov__more[open] > summary::before {
    content: "−";
  }

  .prov__more > summary:hover {
    color: var(--accent);
  }

  .prov__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t--1);
    font-variant-numeric: tabular-nums;
  }

  .prov__table :is(th, td) {
    text-align: left;
    padding: 0.42rem 1.15rem;
    border-top: 1px solid var(--rule);
  }

  .prov__table th {
    font-family: var(--font-mono);
    font-size: var(--t--2);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }

  .prov__table td {
    color: var(--ink-dim);
  }

  .prov__note {
    padding: 0.7rem 1.15rem 0.9rem;
    font-size: var(--t--1);
    color: var(--muted);
  }
</style>
