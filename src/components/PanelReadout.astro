---
/**
 * The eight specialists, with what each scored and how sure it was.
 *
 * This is the thing In Silico can publish that a conventional journal cannot.
 * A normal paper gets three referees whose scores you never see; here there
 * are eight, and the interesting signal is usually not the mean but the
 * *spread* — a paper at 3.5 because every referee said 3.5 is a different
 * paper from one at 3.5 because methodology said 2 and novelty said 5.
 *
 * So each row is coloured by its own score rather than by the panel's verdict.
 * Colouring the whole block one colour would average away exactly the
 * disagreement a reader should notice.
 *
 * Nothing here decides anything. The verdict comes from the editor's decision
 * letter and is not computed from these numbers — a 3.9 mean has been ruled a
 * major revision more often than a minor one. The colours are a scale, not a
 * prediction, and are named so they cannot be read as one.
 *
 * Confidence is shown separately and never mixed into the score. A low score
 * held with low confidence is a weaker claim than the same score held firmly,
 * and folding them together would hide that.
 */
const { panel = [], meanScore = null, decision = "", deskRejected = false } = Astro.props;

const SCALE = 5;

/** Which whole point on the 1–5 scale a score sits nearest. */
function tierFor(score) {
  if (score === null || score === undefined) return "none";
  return `s${Math.min(SCALE, Math.max(1, Math.round(score)))}`;
}

const rows = panel
  .filter((entry) => entry && typeof entry === "object")
  .map((entry) => {
    const score = typeof entry.score === "number" ? entry.score : null;
    const confidence =
      typeof entry.confidence === "number" ? entry.confidence : null;
    return {
      name: String(entry.reviewer || "unknown").replace(/_/g, " "),
      score,
      confidence,
      // A null score means the dimension had nothing to judge in this
      // manuscript. It is shown, not hidden — that a paper has no statistics
      // to check is a fact about the paper — but it carries no meter and no
      // colour, because it is not a point on the scale.
      notApplicable: score === null,
      reason: String(entry.not_applicable_reason || "").trim(),
      tier: tierFor(score),
    };
  })
  // Unscored dimensions sort to the bottom rather than reading as a zero.
  .sort((a, b) => (b.score ?? -Infinity) - (a.score ?? -Infinity));

const scores = rows.map((r) => r.score).filter((s) => s !== null);
const naRows = rows.filter((r) => r.notApplicable);
const low = scores.length ? Math.min(...scores) : null;
const high = scores.length ? Math.max(...scores) : null;
const spread = low !== null && high !== null ? +(high - low).toFixed(1) : null;
const meanTier = tierFor(meanScore);
---

{
  rows.length > 0 && (
    <section class="readout panel" aria-labelledby="panel-readout-heading">
      <div class="panel__head">
        <h2 id="panel-readout-heading" class="readout__title">
          Panel readout
        </h2>
        <p class="label">
          {naRows.length > 0
            ? `${scores.length} of ${rows.length} specialists scored · 1–${SCALE}`
            : `${rows.length} specialist${rows.length === 1 ? "" : "s"} · scored 1–${SCALE}`}
        </p>
      </div>

      <div class="readout__body">
        <div class="readout__aggregate">
          <div class={`readout__mean readout__mean--${meanTier}`}>
            <span class="readout__meanValue mono">
              {meanScore !== null ? meanScore.toFixed(1) : "—"}
            </span>
            <span class="readout__meanScale mono">/ {SCALE}</span>
          </div>
          <p class="label">
            {naRows.length > 0
              ? `Mean over ${scores.length} of ${rows.length}`
              : "Mean panel score"}
          </p>

          {spread !== null && (
            <p class="readout__spread">
              {/* One string rather than adjacent expressions: JSX inserts a
                  whitespace text node between them, which renders as
                  "3.0– 4.0". */}
              {spread === 0
                ? "Every referee landed on the same score."
                : `Range ${low.toFixed(1)}–${high.toFixed(1)}, a spread of ${spread.toFixed(1)}.` +
                  (spread >= 2 ? " The referees disagreed substantially." : "")}
            </p>
          )}
        </div>

        <ol class="readout__rows">
          {rows.map((row) => row.notApplicable ? (
            <li class="readout__row readout__row--na">
              <span class="readout__name">{row.name}</span>
              <span class="readout__naNote">
                {row.reason || "Nothing in this dimension to judge in this manuscript."}
              </span>
              <span class="readout__naTag mono">n/a</span>
            </li>
          ) : (
            <li class={`readout__row readout__row--${row.tier}`}>
              <span class="readout__name">{row.name}</span>

              <span
                class="readout__meter"
                role="img"
                aria-label={`${row.name}: ${row.score} out of ${SCALE}`}
              >
                {Array.from({ length: SCALE }, (_, i) => {
                  const step = i + 1;
                  const filled = row.score !== null && row.score >= step;
                  const half =
                    row.score !== null && !filled && row.score > step - 1;
                  return (
                    <span
                      class={`readout__seg${filled ? " is-filled" : ""}${half ? " is-half" : ""}`}
                    />
                  );
                })}
              </span>

              <span class="readout__score mono">
                {row.score !== null ? row.score.toFixed(1) : "—"}
              </span>

              <span class="readout__conf" title={`Confidence ${row.confidence ?? "—"} of ${SCALE}`}>
                <span class="sr-only">
                  Confidence {row.confidence ?? "unrecorded"} of {SCALE}
                </span>
                {Array.from({ length: SCALE }, (_, i) => (
                  <span
                    class={`readout__dot${row.confidence !== null && row.confidence >= i + 1 ? " is-on" : ""}`}
                    aria-hidden="true"
                  />
                ))}
              </span>
            </li>
          ))}
        </ol>
      </div>

      <p class="readout__foot">
        <span class="label">Score</span> is the referee's assessment of the work.
        <span class="label">Confidence</span> is how sure that referee was of its
        own reading. They are recorded separately and never combined. The
        editor's verdict is its own judgment of the reports, not a threshold
        applied to this mean, so a number here does not predict it.
        {naRows.length > 0 && (
          <>
            {" "}
            <span class="label">n/a</span> means that referee found nothing in
            its dimension to judge here — it is left out of the mean rather
            than counted as a good score, which is what a forced number
            quietly became.
          </>
        )}
      </p>
    </section>
  )
}

<style>
  .readout {
    overflow: hidden;
  }

  .readout__title {
    font-size: var(--t-1);
  }

  .readout__body {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    gap: 0;
  }

  /* Centred rather than top-aligned: the rows beside it are always taller,
     so anchoring the mean to the top leaves a column of dead space under it. */
  .readout__aggregate {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
    padding: 1.3rem 1.15rem;
    border-right: 1px solid var(--rule);
    background: var(--surface-2);
  }

  .readout__mean {
    --v: var(--v-desk);
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    color: var(--v);
  }

  /* The site's verdict palette, reused as a five-step ramp because it is the
     one warm-to-cool scale the design already has. A score tinted like an
     accept is not an accept — see the tier comment above. */
  .readout__mean--s5 { --v: var(--v-accept); }
  .readout__mean--s4 { --v: var(--v-minor); }
  .readout__mean--s3 { --v: var(--v-major); }
  .readout__mean--s2,
  .readout__mean--s1 { --v: var(--v-reject); }

  .readout__meanValue {
    font-family: var(--font-display);
    font-size: 3.4rem;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .readout__meanScale {
    font-size: var(--t--1);
    color: var(--muted);
  }

  .readout__spread {
    margin-top: 0.5rem;
    font-size: var(--t--1);
    line-height: 1.5;
    color: var(--ink-dim);
  }

  .readout__rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .readout__row {
    --v: var(--v-desk);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 2.6rem auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.62rem 1.15rem;
  }

  .readout__row + .readout__row {
    border-top: 1px solid var(--rule);
  }

  .readout__row--s5 { --v: var(--v-accept); }
  .readout__row--s4 { --v: var(--v-minor); }
  .readout__row--s3 { --v: var(--v-major); }
  .readout__row--s2,
  .readout__row--s1 { --v: var(--v-reject); }

  .readout__name {
    font-family: var(--font-mono);
    font-size: var(--t--1);
    letter-spacing: 0.04em;
    text-transform: capitalize;
    color: var(--ink-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .readout__meter {
    display: flex;
    gap: 2px;
  }

  .readout__seg {
    width: 1.5rem;
    height: 0.5rem;
    border-radius: 1px;
    background: color-mix(in srgb, var(--muted) 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--muted) 12%, transparent);
  }

  .readout__seg.is-filled {
    background: var(--v);
    box-shadow: none;
  }

  /* A half-step (3.5) shows as a partly lit segment rather than rounding,
     because the pipeline really does emit them. */
  .readout__seg.is-half {
    background: linear-gradient(
      to right,
      var(--v) 50%,
      color-mix(in srgb, var(--muted) 18%, transparent) 50%
    );
  }

  .readout__score {
    font-size: var(--t--1);
    font-weight: 500;
    text-align: right;
    color: var(--v);
  }

  .readout__conf {
    display: flex;
    gap: 3px;
    align-items: center;
  }

  .readout__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--muted) 28%, transparent);
  }

  .readout__dot.is-on {
    background: var(--muted);
  }

  /* Deliberately colourless and un-metered: an unscored dimension is not a
     point on the scale, and giving it a bar would put it on one. */
  .readout__row--na {
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) auto;
    color: var(--muted);
  }

  .readout__row--na .readout__name {
    color: var(--muted);
  }

  .readout__naNote {
    font-size: var(--t--1);
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .readout__naTag {
    font-size: var(--t--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.1em 0.5em;
  }

  .readout__foot {
    border-top: 1px solid var(--rule);
    padding: 0.8rem 1.15rem;
    font-size: var(--t--1);
    color: var(--muted);
    line-height: 1.55;
  }

  .readout__foot .label {
    color: var(--ink-dim);
  }

  @media (max-width: 46rem) {
    .readout__body {
      grid-template-columns: 1fr;
    }
    .readout__aggregate {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.6rem 1rem;
    }
    .readout__spread {
      margin-top: 0;
      flex-basis: 100%;
    }
    .readout__row {
      grid-template-columns: minmax(0, 1fr) auto 2.4rem;
      gap: 0.6rem;
    }
    .readout__conf,
    .readout__naNote {
      display: none;
    }
    .readout__row--na {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .readout__seg {
      width: 1.1rem;
    }
  }
</style>
