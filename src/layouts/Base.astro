---
import "../styles/global.css";

const {
  title,
  description = "An open, AI-refereed overlay journal. Any field; the whole review published.",
  ogType = "website",
  wide = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = Astro.site ? new URL(base + "/", Astro.site).href.replace(/\/$/, "") : base;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost").href;
const fullTitle = title ? `${title} — In Silico` : "In Silico";

const nav = [
  { href: `${base}/reviews/`, label: "Reviews" },
  { href: `${base}/submit/`, label: "Submit" },
  { href: `${base}/criteria/`, label: "Criteria" },
  { href: `${base}/policy/`, label: "Policy" },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content="In Silico" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? "In Silico"} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />

    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    {/* Applied before first paint so a stored preference never flashes the
        wrong ground. Inline and synchronous on purpose — deferring it is
        exactly what causes the flash. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("insilico-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="wordmark" href={`${base}/`}>
          <span class="wordmark__name">In Silico</span>
          <span class="wordmark__kind">AI-refereed overlay journal</span>
        </a>

        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a
              href={item.href}
              class="site-nav__link"
              aria-current={path.startsWith(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <button
          class="theme-toggle"
          type="button"
          aria-label="Switch between light and dark"
          data-theme-toggle
        >
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
            <circle cx="8" cy="8" r="3.4" fill="currentColor" />
            <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
              <path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3 3l1.1 1.1M11.9 11.9L13 13M13 3l-1.1 1.1M4.1 11.9L3 13" />
            </g>
          </svg>
        </button>
      </div>
    </header>

    <main id="main" class={wide ? "" : ""}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <p class="site-footer__note">
          <strong>In Silico</strong> publishes machine-generated peer review.
          Every recommendation here is <strong>advisory</strong>; a human editor
          makes each decision, and nothing on this site is a certification that a
          result is correct.
        </p>
        <div class="site-footer__meta label">
          <span>Reviews CC BY 4.0 · code MIT</span>
          <a href="https://github.com/pgarrett-scripps/insilico">Repository</a>
          <a href="https://github.com/pgarrett-scripps/PeerReviewAgents">Engine</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.querySelector("[data-theme-toggle]");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var root = document.documentElement;
          var current =
            root.getAttribute("data-theme") ||
            (window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark");
          var next = current === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try {
            localStorage.setItem("insilico-theme", next);
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--ground) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .wordmark__kind {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .site-nav {
    display: flex;
    gap: 1.35rem;
  }

  .site-nav__link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .site-nav__link:hover {
    color: var(--ink);
  }

  .site-nav__link[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
  }

  @media (max-width: 44rem) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: 0.75rem 1rem;
      padding-block: 0.75rem;
    }
    .site-nav {
      order: 3;
      width: 100%;
      gap: 1rem;
      overflow-x: auto;
    }
    .wordmark__kind {
      display: none;
    }
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--ground-deep);
    padding-block: 2.2rem 2.6rem;
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .site-footer__note {
    max-width: var(--measure);
    font-size: var(--t--1);
    color: var(--ink-dim);
    line-height: 1.6;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .site-footer__meta a {
    color: var(--muted);
    text-decoration: none;
  }

  .site-footer__meta a:hover {
    color: var(--accent);
  }
</style>
